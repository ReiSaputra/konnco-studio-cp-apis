// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id          String  @id @default(uuid()) @db.VarChar(255)
  name        String  @db.VarChar(255)
  password    String  @db.VarChar(255)
  email       String  @unique @db.VarChar(255)
  phoneNumber String  @unique @map("phone_number") @db.VarChar(255)
  role        Role
  token       String? @unique @db.VarChar(255)

  blogs       Blog[]
  careers     Career[]
  permissions AdminPermission?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

model AdminPermission {
  id Int @id @default(autoincrement())

  adminId String @unique @map("admin_id") @db.VarChar(255)
  admin   Admin  @relation(fields: [adminId], references: [id])

  canShowBlog Boolean @default(false)

  canCreateBlog Boolean @default(false)
  canViewBlog   Boolean @default(false)
  canUpdateBlog Boolean @default(false)
  canDeleteBlog Boolean @default(false)

  canShowCareer Boolean @default(false)

  canCreateCareer Boolean @default(false)
  canViewCareer   Boolean @default(false)
  canUpdateCareer Boolean @default(false)
  canDeleteCareer Boolean @default(false)

  canShowApplication Boolean @default(false)

  canCreateApplication Boolean @default(false)
  canViewApplication   Boolean @default(false)
  canUpdateApplication Boolean @default(false)
  canDeleteApplication Boolean @default(false)

  canShowProduct Boolean @default(false)

  canCreateProduct Boolean @default(false)
  canViewProduct   Boolean @default(false)
  canUpdateProduct Boolean @default(false)
  canDeleteProduct Boolean @default(false)

  canShowAdmin Boolean @default(false)

  canCreateAdmin Boolean @default(false)
  canViewAdmin   Boolean @default(false)
  canUpdateAdmin Boolean @default(false)
  canDeleteAdmin Boolean @default(false)

  @@map("admin_permissions")
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

model Blog {
  id      String   @id @default(uuid()) @db.VarChar(255)
  title   String   @db.VarChar(255)
  content String   @db.Text
  slug    String   @unique @db.VarChar(255)
  type    BlogType
  photo   String   @db.VarChar(255)

  isVisible Boolean @default(false) @map("is_visible")

  authorId String @map("author_id") @db.VarChar(255)
  author   Admin  @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("blogs")
}

enum BlogType {
  TECH
  BUSINESS
  NEWS
  TUTORIAL
  OTHER
}

model Career {
  id            Int        @id @default(autoincrement())
  title         String     @db.VarChar(255)
  description   String     @db.Text
  salary        String     @db.VarChar(255)
  tags          String     @db.Text
  type          CareerType
  linkedInInfo  String     @map("linkedin_info") @db.VarChar(255)
  glintsInfo    String     @map("glints_info") @db.VarChar(255)
  jobStreetInfo String     @map("jobstreet_info") @db.VarChar(255)

  authorId String @map("author_id") @db.VarChar(255)
  author   Admin  @relation(fields: [authorId], references: [id])

  applications Application[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("careers")
}

model Application {
  id              String               @id @default(uuid()) @db.VarChar(255)
  applicantName   String               @map("applicant_name") @db.VarChar(255)
  email           String               @db.VarChar(255)
  phoneNumber     String               @map("phone_number") @db.VarChar(255)
  educationType   EducationType        @map("education_type")
  instituteName   String               @map("institute_name") @db.VarChar(255)
  companyName     String?              @map("company_name") @db.VarChar(255)
  position        String?              @db.VarChar(255)
  lengthOfService LengthOfServiceType? @map("length_of_service")
  skills          String               @db.Text
  file            String               @map("file") @db.VarChar(255)
  letter          String               @db.Text

  careerId Int    @map("career_id")
  career   Career @relation(fields: [careerId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("applications")
}

enum LengthOfServiceType {
  BELOW_1_YEAR
  ABOVE_1_YEAR
}

enum CareerType {
  UI_UX
  WEB
  MOBILE
  DESKTOP
  SYSTEM_ANALYST
  QUALITY_ASSURANCE
  DATA_ANALYST
  GENERAL_AFFAIR
  MARKETING
  ACCOUNTING
}

enum EducationType {
  SD
  SMP
  SMA
  SMK
  D3
  D4
  S1
  S2
  S3
}

model Inquiry {
  id         String @id @default(uuid()) @db.VarChar(255)
  senderName String @map("sender_name") @db.VarChar(255)
  email      String @db.VarChar(255)
  subject    String @db.VarChar(255)
  message    String @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@map("inquiries")
}
